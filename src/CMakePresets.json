{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "aivm-native-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/../.tmp/aivm-c-build-native",
      "cacheVariables": {
        "AIVM_BUILD_SHARED": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "aivm-native-unix",
      "inherits": "aivm-native-base",
      "generator": "Unix Makefiles"
    },
    {
      "name": "aivm-native-asan-unix",
      "inherits": "aivm-native-base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../.tmp/aivm-c-build-asan",
      "cacheVariables": {
        "AIVM_ENABLE_ASAN": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "aivm-native-ubsan-unix",
      "inherits": "aivm-native-base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../.tmp/aivm-c-build-ubsan",
      "cacheVariables": {
        "AIVM_ENABLE_UBSAN": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "aivm-native-lsan-unix",
      "inherits": "aivm-native-base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../.tmp/aivm-c-build-lsan",
      "cacheVariables": {
        "AIVM_ENABLE_ASAN": "ON",
        "AIVM_ENABLE_LSAN": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "aivm-native-msan-unix",
      "inherits": "aivm-native-base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../.tmp/aivm-c-build-msan",
      "cacheVariables": {
        "AIVM_ENABLE_MSAN": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "aivm-native-windows",
      "inherits": "aivm-native-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "aivm-native-shared-unix",
      "inherits": "aivm-native-base",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../.tmp/aivm-c-build-shared-native",
      "cacheVariables": {
        "AIVM_BUILD_SHARED": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "aivm-native-shared-windows",
      "inherits": "aivm-native-base",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/../.tmp/aivm-c-build-shared-native",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "AIVM_BUILD_SHARED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "aivm-native-unix-build",
      "configurePreset": "aivm-native-unix"
    },
    {
      "name": "aivm-native-windows-build",
      "configurePreset": "aivm-native-windows",
      "configuration": "Debug"
    },
    {
      "name": "aivm-native-asan-unix-build",
      "configurePreset": "aivm-native-asan-unix"
    },
    {
      "name": "aivm-native-ubsan-unix-build",
      "configurePreset": "aivm-native-ubsan-unix"
    },
    {
      "name": "aivm-native-lsan-unix-build",
