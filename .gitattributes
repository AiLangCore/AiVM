# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for source code files
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cs text eol=lf
*.java text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.aos text eol=lf

# Force LF for scripts and makefiles
Makefile text eol=lf
*.mk text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Windows-specific files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary
*.o binary
*.a binary
*.lib binary
*.wasm binary
*.aibc binary
